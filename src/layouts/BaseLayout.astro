---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/public-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '~/styles/global.css';

import type { Lang, PageKey } from '~/i18n/routes';
import { path } from '~/i18n/routes';
import { withBase } from '~/lib/base';
import { company } from '~/data/company';
import commonEs from '~/content/es/common.json';
import commonEn from '~/content/en/common.json';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import WhatsAppButton from '~/components/WhatsAppButton.astro';

interface Props {
  lang: Lang;
  pageKey: PageKey;
  title: string;
  description: string;
  jsonLd?: object[];
}

const { lang, pageKey, title, description, jsonLd = [] } = Astro.props;
const t = lang === 'es' ? commonEs : commonEn;

/* Site real del build actual (astro.config lo define por target):
   producción → saladinig.com · preview → daniel-projectt.github.io.
   path() ya incluye el base path, así las URLs absolutas existen SIEMPRE. */
const site = (Astro.site?.href ?? company.site).replace(/\/$/, '');
const canonical = `${site}${path(pageKey, lang)}`;
const alternateEs = `${site}${path(pageKey, 'es')}`;
const alternateEn = `${site}${path(pageKey, 'en')}`;

/* Vista previa en GitHub Pages: no indexar (el dominio real será saladinig.com) */
const isPreview = process.env.DEPLOY_TARGET === 'gh';
---

<!doctype html>
<html lang={lang === 'es' ? 'es-DO' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-DO" href={alternateEs} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateEs} />
    <meta name="theme-color" content="#0a1420" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_DO' : 'en_US'} />
    <meta property="og:site_name" content="Saladín Industria Gráfica" />
    {isPreview && <meta name="robots" content="noindex" />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    {jsonLd.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <a href="#main" class="skip-link">{t.skipLink}</a>
    <Header lang={lang} pageKey={pageKey} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppButton lang={lang} />
  </body>
</html>
