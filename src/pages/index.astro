---
/* Redirección raíz → idioma por defecto (/es/), respetando el base path. */
import { withBase } from '~/lib/base';
const target = withBase('/es/');
---

<meta http-equiv="refresh" content={`0;url=${target}`} />
<link rel="canonical" href="https://saladinig.com/es/" />
<a href={target}>Saladín Industria Gráfica</a>
