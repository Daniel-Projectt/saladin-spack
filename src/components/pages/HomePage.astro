---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CalibrationBar from '~/components/CalibrationBar.astro';
import PlaceholderImage from '~/components/PlaceholderImage.astro';
import type { Lang } from '~/i18n/routes';
import { path, productPageKeys, type ProductId } from '~/i18n/routes';
import { organizationJsonLd, localBusinessJsonLd } from '~/lib/seo';
import { stockImages } from '~/data/stockImages';
import homeEs from '~/content/es/home.json';
import homeEn from '~/content/en/home.json';
import commonEs from '~/content/es/common.json';
import commonEn from '~/content/en/common.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = lang === 'es' ? homeEs : homeEn;
const c = lang === 'es' ? commonEs : commonEn;

const jsonLd = [organizationJsonLd(), ...localBusinessJsonLd()];
---

<BaseLayout lang={lang} pageKey="home" title={t.meta.title} description={t.meta.description} jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="on-dark bg-ink-950 text-paper">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 md:px-6 md:py-24 lg:grid-cols-[1.15fr_1fr]">
      <div>
        <p class="eyebrow text-spack-300">{t.hero.eyebrow}</p>
        <h1 class="display display-xl mt-4">{t.hero.title}</h1>
        <p class="mt-6 max-w-xl text-lg text-ink-400">{t.hero.subtitle}</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href={path('contact', lang)} class="btn btn-press">{c.cta.quote}</a>
          <a href={path('products', lang)} class="btn btn-outline-light">{c.cta.seeProducts}</a>
        </div>
      </div>
      <PlaceholderImage label={t.hero.imageLabel} alt={t.hero.imageAlt} width={900} height={1000} variant="dark" eager src={stockImages.heroPress} sizes="(min-width: 1024px) 45vw, 100vw" />
    </div>
    <CalibrationBar />
  </section>

  <!-- BANDA DE CONFIANZA -->
  <section class="border-b border-ink-950/10 bg-paper">
    <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-x-4 gap-y-8 px-4 py-10 sm:grid-cols-3 md:px-6 lg:grid-cols-5">
      {t.trust.items.map((item) => (
        <div class="text-center">
          <dt class="sr-only">{item.label}</dt>
          <dd class="display m-0 text-2xl text-ink-950 md:text-3xl">{item.value}</dd>
          <dd class="eyebrow m-0 mt-1.5 text-ink-600">{item.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- 3 PRODUCTOS -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
    <p class="eyebrow text-press-600">{t.products.eyebrow}</p>
    <h2 class="display display-lg mt-2">{t.products.title}</h2>
    <div class="mt-10 grid gap-8 md:grid-cols-3">
      {t.products.items.map((item) => (
        <a
          href={path(productPageKeys[item.id as ProductId], lang)}
          class="group block border border-ink-950/15 bg-paper-white no-underline transition-colors hover:border-press-600"
        >
          <PlaceholderImage label={item.imageLabel} alt={item.imageAlt} width={800} height={600} variant="light" src={stockImages.products[item.id as ProductId][0]} sizes="(min-width: 768px) 33vw, 100vw" />
          <div class="p-6">
            <p class="eyebrow text-press-600">{item.num} <span aria-hidden="true">⌖</span></p>
            <h3 class="display display-md mt-2 text-ink-950">{item.title}</h3>
            <p class="mt-3 text-[0.95rem] text-ink-600">{item.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- BLOQUE SPACK -->
  <section class="flute-texture bg-kraft-100">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 md:px-6 md:py-20 lg:grid-cols-2">
      <div>
        <p class="eyebrow text-spack-700">{t.spack.eyebrow}</p>
        <h2 class="display display-lg mt-2 text-ink-950">{t.spack.title}</h2>
        <p class="mt-5 text-lg text-ink-950/80">{t.spack.desc}</p>
        <ul class="mt-6 space-y-3 pl-0">
          {t.spack.bullets.map((b) => (
            <li class="flex gap-3">
              <span aria-hidden="true" class="mt-0.5 font-mono text-spack-700">⌖</span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
        <a href={path('product-litolaminado', lang)} class="btn btn-outline-dark mt-8">{t.spack.cta}</a>
      </div>
      <PlaceholderImage label={t.spack.imageLabel} alt={t.spack.imageAlt} width={900} height={700} variant="kraft" src={stockImages.spackPlant} />
    </div>
  </section>

  <!-- MARCAS QUE CONFIARON -->
  <section class="mx-auto max-w-6xl px-4 py-16 text-center md:px-6 md:py-24">
    <p class="eyebrow text-press-600">{t.clients.eyebrow}</p>
    <h2 class="display display-lg mt-2">{t.clients.title}</h2>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-ink-600">{t.clients.desc}</p>
    <p class="display mt-8 text-xl text-kraft-700">{t.clients.note}</p>
  </section>

  <!-- CTA FINAL -->
  <section class="on-dark bg-ink-950 text-paper">
    <CalibrationBar />
    <div class="mx-auto max-w-4xl px-4 py-16 text-center md:px-6 md:py-24">
      <h2 class="display display-lg">{t.finalCta.title}</h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-ink-400">{t.finalCta.desc}</p>
      <a href={path('contact', lang)} class="btn btn-press mt-8">{t.finalCta.button}</a>
    </div>
  </section>
</BaseLayout>
