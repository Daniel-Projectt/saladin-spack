---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import PlaceholderImage from '~/components/PlaceholderImage.astro';
import type { Lang } from '~/i18n/routes';
import { path, productPageKeys, type ProductId } from '~/i18n/routes';
import productsEs from '~/content/es/products.json';
import productsEn from '~/content/en/products.json';
import homeEs from '~/content/es/home.json';
import homeEn from '~/content/en/home.json';
import commonEs from '~/content/es/common.json';
import commonEn from '~/content/en/common.json';
import { stockImages } from '~/data/stockImages';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = lang === 'es' ? productsEs : productsEn;
const home = lang === 'es' ? homeEs : homeEn;
const c = lang === 'es' ? commonEs : commonEn;

const ids: ProductId[] = ['plegadizas', 'litolaminado', 'etiquetas'];
---

<BaseLayout lang={lang} pageKey="products" title={t.meta.title} description={t.meta.description}>
  <div class="mx-auto max-w-6xl px-4 pt-8 md:px-6">
    <Breadcrumbs items={[{ label: c.breadcrumbHome, href: path('home', lang) }, { label: c.nav.products }]} />
  </div>

  <section class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
    <p class="eyebrow text-press-600">{t.hero.eyebrow}</p>
    <h1 class="display display-xl mt-3 max-w-4xl">{t.hero.title}</h1>
    <p class="mt-6 max-w-3xl text-lg text-ink-600">{t.hero.subtitle}</p>
  </section>

  <section class="mx-auto max-w-6xl space-y-10 px-4 pb-20 md:px-6">
    {ids.map((id, i) => {
      const p = t.items[id];
      const homeItem = home.products.items.find((x) => x.id === id);
      return (
        <article class="grid items-center gap-8 border border-ink-950/15 bg-paper-white p-6 md:p-8 lg:grid-cols-[1fr_1.2fr]">
          <PlaceholderImage label={homeItem?.imageLabel ?? p.name} width={800} height={600} variant={id === 'litolaminado' ? 'kraft' : 'light'} src={stockImages.products[id][0]} />
          <div>
            <p class="eyebrow text-press-600">0{i + 1} <span aria-hidden="true">⌖</span></p>
            <h2 class="display display-md mt-2">{p.name}</h2>
            <p class="mt-4 text-ink-600">{p.intro}</p>
            <div class="mt-6 flex flex-wrap gap-4">
              <a href={path(productPageKeys[id], lang)} class="btn btn-outline-dark">{t.detailCta}</a>
              <a href={`${path('contact', lang)}?${lang === 'es' ? 'producto' : 'product'}=${id}`} class="btn btn-press">{t.quoteCta}</a>
            </div>
          </div>
        </article>
      );
    })}
  </section>
</BaseLayout>
