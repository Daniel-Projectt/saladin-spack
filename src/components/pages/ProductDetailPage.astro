---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import PlaceholderImage from '~/components/PlaceholderImage.astro';
import CalibrationBar from '~/components/CalibrationBar.astro';
import type { Lang, ProductId } from '~/i18n/routes';
import { path, productPageKeys } from '~/i18n/routes';
import { company } from '~/data/company';
import { productJsonLd } from '~/lib/seo';
import { stockImages } from '~/data/stockImages';
import productsEs from '~/content/es/products.json';
import productsEn from '~/content/en/products.json';
import commonEs from '~/content/es/common.json';
import commonEn from '~/content/en/common.json';

interface Props {
  lang: Lang;
  productId: ProductId;
}

const { lang, productId } = Astro.props;
const t = lang === 'es' ? productsEs : productsEn;
const c = lang === 'es' ? commonEs : commonEn;
const p = t.items[productId];
const pageKey = productPageKeys[productId];

const quoteHref = `${path('contact', lang)}?${lang === 'es' ? 'producto' : 'product'}=${productId}`;
const isSpack = productId === 'litolaminado';

/* Las specs marcadas [REEMPLAZAR]/[REPLACE] son datos pendientes del cliente:
   viven en el JSON pero NUNCA se sirven en el HTML. */
const specs = p.specs.filter((s) => !/\[(REEMPLAZAR|REPLACE)/i.test(s.value));

const jsonLd = [
  productJsonLd({
    name: p.name,
    description: p.meta.description,
    url: `${company.site}${path(pageKey, lang)}`,
    lang,
  }),
];
---

<BaseLayout lang={lang} pageKey={pageKey} title={p.meta.title} description={p.meta.description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-4 pt-8 md:px-6">
    <Breadcrumbs
      items={[
        { label: c.breadcrumbHome, href: path('home', lang) },
        { label: c.nav.products, href: path('products', lang) },
        { label: p.shortName },
      ]}
    />
  </div>

  <!-- INTRO -->
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 md:px-6 md:py-16 lg:grid-cols-[1.2fr_1fr]">
    {/* min-w-0: sin esto, una palabra larga (MICROCORRUGADO) infla el
        min-content de la columna y aplasta la de la foto */}
    <div class="min-w-0">
      {isSpack && <p class="eyebrow text-spack-700">SPACK · {lang === 'es' ? 'Zona Franca Las Américas' : 'Las Américas Free Trade Zone'}</p>}
      <h1 class="display display-lg mt-2">{p.name}</h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-600">{p.intro}</p>
      <a href={quoteHref} class="btn btn-press mt-8">{t.quoteCta}</a>
    </div>
    <PlaceholderImage label={p.gallery[0]} alt={p.galleryAlts[0]} width={800} height={700} variant={isSpack ? 'kraft' : 'light'} eager src={stockImages.products[productId][0]} sizes="(min-width: 1024px) 40vw, 100vw" />
  </section>

  <!-- INDUSTRIAS -->
  <section class:list={['py-14 md:py-20', isSpack ? 'flute-texture bg-kraft-100' : 'bg-kraft-100/50']}>
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <h2 class="display display-md">{t.industriesLabel}</h2>
      <ul class="mt-8 grid list-none gap-4 pl-0 sm:grid-cols-2 lg:grid-cols-5">
        {p.industries.map((ind) => (
          <li class="border border-ink-950/15 bg-paper-white p-5">
            <p class="font-bold">{ind.name}</p>
            <p class="mt-1.5 text-[0.9rem] text-ink-600">{ind.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ESPECIFICACIONES -->
  <section class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
    <h2 class="display display-md">{t.specsLabel}</h2>
    <div class="mt-6 max-w-3xl overflow-x-auto border border-ink-950/15 bg-paper-white">
      <table class="w-full border-collapse font-mono text-[0.9rem]">
        <tbody>
          {specs.map((spec) => (
            <tr class="border-b border-ink-950/10 last:border-b-0">
              <th scope="row" class="w-40 px-4 py-3 text-left align-top uppercase tracking-wider text-press-600">{spec.label}</th>
              <td class="px-4 py-3">{spec.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="eyebrow mt-10 text-ink-600">{t.capabilitiesLabel}</h2>
    <ul class="mt-3 flex list-none flex-wrap gap-3 pl-0">
      {t.sharedCapabilities.map((cap) => (
        <li class="border border-kraft-400 bg-kraft-100 px-3 py-1.5 text-[0.9rem]">{cap}</li>
      ))}
    </ul>
  </section>

  <!-- GALERÍA -->
  <section class="mx-auto max-w-6xl px-4 pb-14 md:px-6 md:pb-20">
    <h2 class="display display-md">{t.galleryLabel}</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {/* La galería usa las fotos 2 y 3 (la 1 ya es el hero de arriba);
          la posición sin foto vuelve al placeholder etiquetado. */}
      {p.gallery.map((label, i) => (
        <PlaceholderImage
          label={label}
          alt={p.galleryAlts[i + 1]}
          width={800}
          height={600}
          variant={isSpack ? 'kraft' : 'light'}
          src={stockImages.products[productId][i + 1]}
          sizes="(min-width: 640px) 33vw, 100vw"
        />
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="on-dark bg-ink-950 text-paper">
    <CalibrationBar />
    <div class="mx-auto max-w-4xl px-4 py-16 text-center md:px-6 md:py-20">
      <h2 class="display display-lg">{p.cta.title}</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-ink-400">{p.cta.desc}</p>
      <a href={quoteHref} class="btn btn-press mt-8">{t.quoteCta}</a>
    </div>
  </section>
</BaseLayout>
