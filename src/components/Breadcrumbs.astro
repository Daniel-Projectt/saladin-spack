---
import { breadcrumbJsonLd } from '~/lib/seo';

interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="eyebrow text-ink-600">
  <ol class="m-0 flex list-none flex-wrap gap-1.5 p-0">
    {items.map((item, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true">/</span>}
        {item.href ? (
          <a href={item.href} class="text-ink-600 no-underline hover:text-press-600 hover:underline">{item.label}</a>
        ) : (
          <span aria-current="page" class="text-ink-950">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd(items))} />
