---
import type { Lang } from '~/i18n/routes';
import { company } from '~/data/company';
import commonEs from '~/content/es/common.json';
import commonEn from '~/content/en/common.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = lang === 'es' ? commonEs : commonEn;
const href = `${company.whatsappHref}?text=${encodeURIComponent(t.whatsapp.message)}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={t.whatsapp.label}
  class="fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25d366] shadow-lg transition-transform hover:scale-105"
>
  <svg viewBox="0 0 32 32" width="30" height="30" fill="#fff" aria-hidden="true">
    <path d="M16 3C9.4 3 4 8.3 4 14.9c0 2.6.8 5 2.3 7L4.7 27l5.3-1.5c1.9 1 4 1.6 6 1.6 6.6 0 12-5.3 12-11.9S22.6 3 16 3zm0 21.7c-1.8 0-3.6-.5-5.2-1.4l-.4-.2-3.1.9.9-3-.2-.4c-1.1-1.6-1.6-3.4-1.6-5.3 0-5.4 4.3-9.7 9.6-9.7s9.6 4.4 9.6 9.7-4.3 9.4-9.6 9.4zm5.3-7.2c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.1-.2.3-.8.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.4-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.4.1-.6l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.4z" />
  </svg>
</a>
