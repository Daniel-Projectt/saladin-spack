---
/**
 * Formulario RFQ real de imprenta.
 * Endpoint [REEMPLAZAR-B2]: crear el form en Formspree y poner la URL real en
 * FORM_ENDPOINT. Mientras el endpoint siga siendo el marcador, el formulario
 * se renderiza deshabilitado con un aviso amable (nunca envía a un 404).
 * Envío por fetch con estados de éxito/error en vivo + honeypot anti-spam.
 * Preselección de producto vía ?producto= / ?product= (script al final).
 */
import type { Lang } from '~/i18n/routes';
import contactEs from '~/content/es/contact.json';
import contactEn from '~/content/en/contact.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const f = (lang === 'es' ? contactEs : contactEn).form;

/* [REEMPLAZAR-B2] con el ID real de Formspree, p. ej. https://formspree.io/f/abcd1234 */
const FORM_ENDPOINT = 'https://formspree.io/f/' + 'PENDIENTE';
const formReady = !FORM_ENDPOINT.endsWith('PENDIENTE');
---

{
  !formReady && (
    <p class="mb-6 border-2 border-kraft-400 bg-kraft-100 p-4 text-[0.95rem]" role="status">
      {f.disabledNote}
    </p>
  )
}

<form class="grid gap-5 md:grid-cols-2" id="rfq-form" data-endpoint={formReady ? FORM_ENDPOINT : undefined} novalidate={!formReady}>
  <fieldset disabled={!formReady} class="contents border-0 p-0">
    <input type="hidden" name="_language" value={lang} />

    <p class="hidden" aria-hidden="true">
      <label>
        No llenar este campo
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
      </label>
    </p>

    <div>
      <label for="rfq-name" class="field-label">{f.name} *</label>
      <input id="rfq-name" name="name" type="text" required autocomplete="name" class="field-input" />
    </div>

    <div>
      <label for="rfq-company" class="field-label">{f.company} *</label>
      <input id="rfq-company" name="company" type="text" required autocomplete="organization" class="field-input" />
    </div>

    <div>
      <label for="rfq-email" class="field-label">{f.email} *</label>
      <input id="rfq-email" name="email" type="email" required autocomplete="email" class="field-input" />
    </div>

    <div>
      <label for="rfq-phone" class="field-label">{f.phone} *</label>
      <input id="rfq-phone" name="phone" type="tel" required autocomplete="tel" class="field-input" />
    </div>

    <div>
      <label for="rfq-product" class="field-label">{f.productType} *</label>
      <select id="rfq-product" name="product_type" required class="field-input">
        {f.productOptions.map((opt) => <option value={opt.value}>{opt.label}</option>)}
      </select>
    </div>

    <div>
      <label for="rfq-quantity" class="field-label">{f.quantity} *</label>
      <input id="rfq-quantity" name="quantity" type="text" required placeholder={f.quantityPlaceholder} class="field-input" />
    </div>

    <div>
      <label for="rfq-dimensions" class="field-label">{f.dimensions}</label>
      <input id="rfq-dimensions" name="dimensions" type="text" placeholder={f.dimensionsPlaceholder} class="field-input" />
    </div>

    <div>
      <label for="rfq-date" class="field-label">{f.targetDate}</label>
      <input id="rfq-date" name="target_date" type="date" class="field-input" />
    </div>

    <div class="md:col-span-2">
      <label for="rfq-message" class="field-label">{f.message} *</label>
      <textarea id="rfq-message" name="message" required rows="5" placeholder={f.messagePlaceholder} class="field-input"></textarea>
      <p class="mt-2 text-sm text-ink-600">{f.attachmentNote}</p>
    </div>

    <div class="md:col-span-2 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <button type="submit" class="btn btn-press">{f.submit}</button>
      <p class="text-sm text-ink-600">{f.requiredNote}</p>
    </div>
  </fieldset>

  <div
    id="rfq-status"
    class="md:col-span-2 hidden border-2 p-4 text-[0.95rem] font-semibold"
    aria-live="polite"
    data-success={f.success}
    data-error={f.error}
  >
  </div>
</form>

<script>
  const form = document.getElementById('rfq-form') as HTMLFormElement | null;
  const status = document.getElementById('rfq-status');
  const endpoint = form?.dataset.endpoint;

  // Preselección del producto desde ?producto= (ES) o ?product= (EN)
  const params = new URLSearchParams(window.location.search);
  const wanted = params.get('producto') ?? params.get('product');
  if (wanted) {
    const select = document.getElementById('rfq-product') as HTMLSelectElement | null;
    if (select && Array.from(select.options).some((o) => o.value === wanted)) {
      select.value = wanted;
    }
  }

  // La fecha objetivo no puede ser pasada
  const dateInput = document.getElementById('rfq-date') as HTMLInputElement | null;
  if (dateInput) {
    const now = new Date();
    now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
    dateInput.min = now.toISOString().split('T')[0];
  }

  // Envío por fetch con estados inline (solo si hay endpoint real)
  if (form && status && endpoint) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.classList.add('hidden');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        form.reset();
        status.textContent = status.dataset.success ?? '';
        status.className = 'md:col-span-2 border-2 border-green-700 bg-green-50 p-4 text-[0.95rem] font-semibold text-green-900';
      } catch {
        status.textContent = status.dataset.error ?? '';
        status.className = 'md:col-span-2 border-2 border-press-600 bg-red-50 p-4 text-[0.95rem] font-semibold text-press-700';
      } finally {
        if (button) button.disabled = false;
        status.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  }
</script>
